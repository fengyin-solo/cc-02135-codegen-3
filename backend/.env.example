# 后端环境变量配置示例
# 复制此文件为 .env 并修改配置

# 服务端口
PORT=8636

# 上传文件存储路径
UPLOAD_FOLDER=/app/uploads

# SQLite数据库文件路径
DB_FILE=/app/data/app.db

# Token过期时间（秒）
TOKEN_EXPIRE_SECONDS=300

# 速率限制配置
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# 文件上传限制
MAX_FILE_SIZE=52428800

# 分享链接默认过期时间（小时）
SHARE_LINK_EXPIRE_HOURS=24

# 分享链接默认最大下载次数
SHARE_LINK_MAX_DOWNLOADS=10

# 下载授权策略中心管理员账号（逗号分隔，如 admin,ops）
ADMIN_USERNAMES=admin
